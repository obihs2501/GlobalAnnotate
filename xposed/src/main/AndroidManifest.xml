<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Modern libxposed API 102 does NOT use xposedmodule / xposedminversion /
         xposeddescription / xposedscope meta-data. Module name comes from
         android:label, description from android:description, and config from
         META-INF/xposed/module.prop + scope.list. -->
    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_edit"
        android:label="@string/xposed_module_name"
        android:description="@string/xposed_module_desc"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".ModuleActivity"
            android:exported="true"
            android:label="@string/xposed_module_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
