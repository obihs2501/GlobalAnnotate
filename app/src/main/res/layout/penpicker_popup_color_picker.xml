<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_root"
    android:background="@drawable/penpicker_popup_bg"
    android:layout_width="@dimen/penpicker_color_picker_popup_width"
    android:layout_height="@dimen/pk_color_picker_popup_height">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="@dimen/penpicker_color_picker_popup_view_page_margin_start_end">
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pk_color_picker_popup_color_title"
            android:layout_centerInParent="true"
            style="@style/penpicker_colorpicker_title"/>
        <com.globalannotate.app.penpicker.PickerStrawTool
            android:id="@+id/penpicker_btn_straw"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.globalannotate.app.penpicker.FilterSortView
        android:id="@+id/penpicker_popup_tab"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="@dimen/penpicker_color_picker_popup_view_page_margin_start_end"
        app:filterSortViewStrokeEnabled="true">
        <view
            android:id="@+id/penpicker_popup_grid_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/pk_color_picker_popup_tab_grid"
            class="com.globalannotate.app.penpicker.FilterSortView$TabView"/>
        <view
            android:id="@+id/penpicker_popup_slider_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/pk_color_picker_popup_tab_slider"
            class="com.globalannotate.app.penpicker.FilterSortView$TabView"/>
    </com.globalannotate.app.penpicker.FilterSortView>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/penpicker_custom_view_pager"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"/>
    </ScrollView>
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="@dimen/penpicker_color_picker_popup_view_page_margin_start_end">
        <ImageView
            android:id="@+id/penpicker_display_block"
            android:background="@drawable/penpicker_color_picker_color_display_block"
            android:clickable="false"
            android:layout_width="@dimen/penpicker_color_picker_popup_picker_display_width_height"
            android:layout_height="@dimen/penpicker_color_picker_popup_picker_display_width_height"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"
            android:layout_alignParentStart="true"
            style="?android:attr/borderlessButtonStyle"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@+id/penpicker_display_block">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/penpicker_recent_color_list_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/penpicker_recent_color_list_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
