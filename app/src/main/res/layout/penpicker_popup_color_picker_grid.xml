<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/penpicker_color_picker_grid"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pk_color_picker_slider_hue_label"
            android:importantForAccessibility="yes"
            android:layout_marginStart="5dp"
            style="@style/penpicker_pen_set"/>
        <com.globalannotate.app.penpicker.ColorPickPanelView
            android:id="@+id/penpicker_color_picker_panel"
            android:padding="5dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="330dp"
            android:layout_height="230dp"
            android:layout_marginTop="3dp"
            android:importantForAccessibility="yes"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/grid_alpha_seekbar_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="5dp">
            <RelativeLayout
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/grid_alpha_text"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pk_color_picker_popup_alpha_label"
                    android:importantForAccessibility="yes"
                    android:layout_alignParentStart="true"
                    style="@style/penpicker_pen_set"/>
                <TextView
                    android:id="@+id/grid_alpha_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    style="@style/penpicker_pen_set"/>
            </RelativeLayout>
            <com.globalannotate.app.penpicker.ColorPickerAlphaView
                android:id="@+id/grid_alpha_seek_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:thumb="@drawable/color_picker_thumb"
                android:contentDescription="@string/pk_color_picker_popup_alpha_label"
                android:splitTrack="false"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
