<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/penpicker_color_picker_slider"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="@dimen/pk_color_picker_view_page_slider_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pk_color_picker_view_page_slider_margin_start">
        <TextView
            android:id="@+id/slider_hue_text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pk_color_picker_slider_hue_label"
            android:importantForAccessibility="yes"
            style="@style/penpicker_pen_set"/>
        <com.globalannotate.app.penpicker.ColorPickerHueView
            android:id="@+id/slider_hue"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pk_color_picker_view_page_slider_seek_bar_height"
            android:layout_marginTop="@dimen/pk_color_picker_view_page_slider_seek_bar_margin_top"
            android:thumb="@drawable/color_picker_thumb"
            android:contentDescription="@string/pk_color_picker_slider_hue_label"
            android:splitTrack="false"/>
        <TextView
            android:id="@+id/slider_saturation_text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pk_color_picker_view_page_slider_text_margin_top"
            android:text="@string/pk_color_picker_slider_saturation_label"
            android:importantForAccessibility="yes"
            style="@style/penpicker_pen_set"/>
        <com.globalannotate.app.penpicker.ColorPickerSaturationView
            android:id="@+id/slider_saturation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pk_color_picker_view_page_slider_seek_bar_height"
            android:layout_marginTop="@dimen/pk_color_picker_view_page_slider_seek_bar_margin_top"
            android:thumb="@drawable/color_picker_thumb"
            android:contentDescription="@string/pk_color_picker_slider_saturation_label"
            android:splitTrack="false"/>
        <TextView
            android:id="@+id/slider_lightness_text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pk_color_picker_view_page_slider_text_margin_top"
            android:text="@string/pk_color_picker_slider_lightness_label"
            android:importantForAccessibility="yes"
            style="@style/penpicker_pen_set"/>
        <com.globalannotate.app.penpicker.ColorPickerLightnessView
            android:id="@+id/slider_lightness"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pk_color_picker_view_page_slider_seek_bar_height"
            android:layout_marginTop="@dimen/pk_color_picker_view_page_slider_seek_bar_margin_top"
            android:thumb="@drawable/color_picker_thumb"
            android:contentDescription="@string/pk_color_picker_slider_lightness_label"
            android:splitTrack="false"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/slider_alpha_seekbar_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pk_color_picker_view_page_slider_text_margin_top">
            <RelativeLayout
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/slider_alpha_text"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pk_color_picker_popup_alpha_label"
                    android:importantForAccessibility="yes"
                    android:layout_alignParentStart="true"
                    style="@style/penpicker_pen_set"/>
                <TextView
                    android:id="@+id/slider_alpha_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    style="@style/penpicker_pen_set"/>
            </RelativeLayout>
            <com.globalannotate.app.penpicker.ColorPickerAlphaView
                android:id="@+id/slider_alpha_seek_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pk_color_picker_view_page_slider_seek_bar_height"
                android:layout_marginTop="@dimen/pk_color_picker_view_page_slider_seek_bar_margin_top"
                android:thumb="@drawable/color_picker_thumb"
                android:contentDescription="@string/pk_color_picker_popup_alpha_label"
                android:splitTrack="false"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
