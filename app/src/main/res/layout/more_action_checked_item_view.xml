<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">
    <ImageView
        android:id="@+id/more_action_checked_item_icon"
        android:visibility="invisible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/picker_selected"
        android:scaleType="centerInside"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:id="@+id/more_action_checked_item_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pk_more_tool_option_finger_write"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/more_action_checked_item_icon"
        android:layout_alignParentStart="true"
        style="@style/penpicker_more_action_item"/>
</RelativeLayout>
