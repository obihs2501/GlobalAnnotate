<?xml version="1.0" encoding="utf-8"?>
<!-- Mi Canvas penpicker_layout_pen_property_item, with the root swapped from
     ConstraintLayout to RelativeLayout so no ConstraintLayout dependency is
     needed. The three views keep their original ids, order, sizes and the
     8dp gap between the title row and the slider. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:ellipsize="end"
        android:id="@+id/penpicker_property_title"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_alignParentStart="true"
        android:importantForAccessibility="yes"
        style="@style/penpicker_pen_set"/>
    <TextView
        android:id="@+id/penpicker_property_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        style="@style/penpicker_pen_set"/>
    <com.globalannotate.app.penpicker.SelectPropertyView
        android:id="@+id/pk_property_seekbar"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_below="@+id/penpicker_property_title"
        android:layout_marginTop="8dp"
        android:splitTrack="false"/>
</RelativeLayout>
