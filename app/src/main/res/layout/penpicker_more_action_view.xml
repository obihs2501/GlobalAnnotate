<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_root"
    android:background="@drawable/penpicker_more_action_popup_bg"
    android:scrollbars="none"
    android:layout_width="@dimen/penpicker_common_edit_popup_window_width"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/more_action_item_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.globalannotate.app.penpicker.DividingLine
            android:id="@+id/more_action_dividing_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/more_action_checked_item_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
